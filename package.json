{
  "name": "astrofinance",
  "version": "0.0.0",
  "description": "Gestor financiero personal 100 % offline (Angular + SQLite WASM + OPFS).",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:boundaries": "node tools/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ng test --watch=false --coverage",
    "test:watch": "ng test",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium firefox webkit",
    "serve:dist": "node tools/serve-dist.mjs",
    "audit": "npm audit --audit-level=high",
    "ci": "npm run format:check && npm run lint && npm run lint:boundaries && npm run typecheck && npm test && npm run build && npm run e2e && npm run audit"
  },
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.2",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@fontsource/poppins": "5.2.7",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "material-symbols": "0.47.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "angular-eslint": "22.5.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
